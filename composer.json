{
  "name": "chabadrichmond/embed-forms",
  "description": "Embeddable form builder for WordPress with USAePay payments",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": { "EmbedForms\\": "src/" }
  },
  "autoload-dev": {
    "psr-4": { "EmbedForms\\Tests\\": "tests/" }
  },
  "config": {
    "platform": { "php": "8.1.0" },
    "sort-packages": true
  },
  "scripts": {
    "test": "phpunit"
  }
}
